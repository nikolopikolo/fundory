<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Fundory" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fundory_dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Fundory.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fundory_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fundory_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Fundory</item>
    </style>

</resources>
